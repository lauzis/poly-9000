{
    "name": "lauzis/poly-9000",
    "description": "LLM translation plugin for WordPress",
    "type": "wordpress-plugin",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/lauzis/wp-plugin-packages"
        }
    ],
    "require": {
        "php": ">=8.0",
        "htmlburger/carbon-fields": "^3.6",
        "lauzis/wp-plugin-packages": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Poly9000\\": "classes/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
